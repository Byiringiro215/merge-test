# Read at runtime by the SvelteKit server (via $env/dynamic/public).
# Must be set before `docker compose up` — a missing value will cause the container to refuse to start.
PUBLIC_API_URL=https://tdmptest.rtb.gov.rw/api

# Public origin (scheme://host[:port]) the browser will use to reach this app.
# Used by SvelteKit's adapter-node CSRF protection.
ORIGIN=https://tdmptest.rtb.gov.rw

# Host port for docker compose to publish the container's port 3000 on.
PORT=4001
